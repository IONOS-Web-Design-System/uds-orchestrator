# =============================================================================
# ⚠️  PARKED — Plan A (egress-allowlist) skills sync. NOT ACTIVE.
#
# Pull-on-host model: the VM `git fetch`es uds-orchestrator from github and
# checks out the released tag. Requires the VM to have github.com egress.
# Disabled (`.disabled` → GitHub Actions ignores it) while we run the side-load /
# minimum-egress model (Plan B → sync-sideload.yml), where the VM has NO github
# egress and skills are PUSHED in over SSH instead.
#
# REACTIVATE once DevOps grants the VM github egress:
#   1. git mv sync-to-pipeline-host.yml.disabled sync-to-pipeline-host.yml
#   2. git mv sync-sideload.yml sync-sideload.yml.disabled
#   3. ensure /opt/pipeline/uds-orchestrator is a git clone on the VM.
# Plan: agent-svc/docs/superpowers/plans/2026-06-02-prod-deploy-allowlist.md
# =============================================================================
name: Sync to pipeline-host
on:
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      git_ref:
        description: 'Tag or commit to sync (defaults to latest release)'
        required: false

jobs:
  sync:
    # Self-hosted required — pipeline-host is on the IONOS internal network.
    runs-on: self-hosted
    environment: production
    steps:
      - name: Resolve ref to sync
        id: ref
        run: |
          if [ -n "${{ inputs.git_ref }}" ]; then
            echo "value=${{ inputs.git_ref }}" >> "$GITHUB_OUTPUT"
          else
            echo "value=${{ github.event.release.tag_name }}" >> "$GITHUB_OUTPUT"
          fi

      - name: Install SSH key
        uses: shimataro/ssh-key-action@v2
        with:
          key: ${{ secrets.SSH_DEPLOY_KEY }}
          known_hosts: ${{ vars.PIPELINE_HOST_KNOWN_HOSTS }}

      - name: Pull released ref onto pipeline-host
        run: |
          ssh -o StrictHostKeyChecking=yes deploy@${{ vars.PIPELINE_HOST }} bash <<EOF
            set -e
            cd /opt/pipeline/uds-orchestrator
            git fetch --tags origin
            git checkout ${{ steps.ref.outputs.value }}
            git rev-parse HEAD
          EOF

      - name: Verify checkout
        run: |
          ssh -o StrictHostKeyChecking=yes deploy@${{ vars.PIPELINE_HOST }} \
            'cd /opt/pipeline/uds-orchestrator && git describe --tags --exact-match || git rev-parse --short HEAD'
